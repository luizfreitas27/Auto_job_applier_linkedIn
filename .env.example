# Copy to ".env" and fill in what you use. ".env" is ignored by git.
# These win over user_config.json and config/secrets.py; a real environment variable wins over this file.
# Leave a line empty (or delete it) to fall back to the control panel / config files.
# A value set here shows up disabled in the control panel. Only a line STARTING with # is a
# comment: a # after the value is part of the value, so passwords with # need no quoting.

# LinkedIn login (optional: leave empty to log in by hand or via the browser profile)
LINKEDIN_USERNAME=
LINKEDIN_PASSWORD=

# AI provider key (only when use_AI is on; "not-needed" for local servers like Ollama)
LLM_API_KEY=

# Telegram notifications (both or neither)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
